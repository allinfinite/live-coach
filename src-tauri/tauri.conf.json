{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Live Coach",
  "version": "0.3.0",
  "identifier": "com.dnalevity.livecoach",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Live Coach",
        "width": 460,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:",
      "capabilities": [
        {
          "identifier": "main",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../ATTRIBUTION.md": "ATTRIBUTION.md",
      "../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md",
      "../voice-runtime/engine.py": "voice-runtime/engine.py"
    }
  }
}
